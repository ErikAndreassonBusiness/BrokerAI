// Checks that the data files are valid before the agent's changes are committed.
// Usage: node scripts/validate.js
const fs = require('fs');
const path = require('path');

const dir = path.join(__dirname, '..', 'data');
const errors = [];
const read = f => {
  try { return JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')); }
  catch (e) { errors.push(`${f}: invalid JSON (${e.message})`); return []; }
};

const companies = read('companies.json');
const reports = read('reports.json');
const updates = read('updates.json');

const ids = new Set();
companies.forEach((c, i) => {
  if (!c.id || !/^[a-z0-9-]+$/.test(c.id)) errors.push(`companies[${i}]: id must be lowercase letters, digits or dashes`);
  if (ids.has(c.id)) errors.push(`companies[${i}]: duplicate id ${c.id}`);
  if (!c.name) errors.push(`companies[${i}]: missing name`);
  ids.add(c.id);
});

const numOrNull = ['revenue', 'ebit', 'net_income', 'eps', 'operating_cash_flow', 'net_debt', 'dividend_per_share'];
const seen = new Set();
reports.forEach((r, i) => {
  const at = `reports[${i}] (${r.company} ${r.period})`;
  if (!ids.has(r.company)) errors.push(`${at}: unknown company`);
  if (!/^\d{4}-Q[1-4]$/.test(r.period || '')) errors.push(`${at}: period must look like 2026-Q2`);
  if (r.report_date && !/^\d{4}-\d{2}-\d{2}$/.test(r.report_date)) errors.push(`${at}: report_date must be YYYY-MM-DD`);
  const key = r.company + '|' + r.period;
  if (seen.has(key)) errors.push(`${at}: duplicate company + period`);
  seen.add(key);
  numOrNull.forEach(k => {
    if (r[k] !== undefined && r[k] !== null && typeof r[k] !== 'number') errors.push(`${at}: ${k} must be a number or null`);
  });
  if (r.source_url && !/^https?:\/\//.test(r.source_url)) errors.push(`${at}: source_url must start with http(s)`);
});

updates.forEach((u, i) => {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(u.date || '')) errors.push(`updates[${i}]: date must be YYYY-MM-DD`);
  if (typeof u.summary !== 'string') errors.push(`updates[${i}]: missing summary`);
});
for (let i = 1; i < updates.length; i++) {
  if (updates[i].date > updates[i - 1].date) errors.push('updates.json must be sorted newest first');
}

if (errors.length) {
  console.error('Data validation failed:\n- ' + errors.join('\n- '));
  process.exit(1);
}
console.log(`OK: ${companies.length} companies, ${reports.length} reports, ${updates.length} updates`);
